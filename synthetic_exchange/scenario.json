          "headers": {
            "ETag": "\"a-v1\"",
            "Content-Type": "text/html; charset=utf-8"
          }
        }
      ]
    },
    {
      "path": "/article/a/2",
      "responses": [
        {
          "body": "<html><main><p>恢复进水并确认没有渗漏。</p></main></html>",
